@model IEnumerable<Lesson_6_GameTracker_.Models.Game>

@{
    ViewData["Title"] = "Мій ігровий каталог";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

<div class="text-center mt-5">
    <div>@ViewBag.ApiStatus</div>
    <div>@ViewBag.Token</div>
    <div>Платіжний ключ: @ViewBag.ApiKey</div>
</div>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-5 fw-bold text-dark">
            <i class="fas fa-layer-group text-primary me-2"></i>Бібліотека ігор
        </h1>
        <a asp-action="Create" class="btn btn-primary btn-lg rounded-pill shadow-sm">
            <i class="fas fa-plus me-2"></i>Додати гру
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="fas fa-gamepad fa-5x text-muted mb-3"></i>
            <p class="h4 text-secondary">Ваша бібліотека поки порожня. Час щось додати!</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 rounded-4 game-card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title fw-bold mb-0">@item.Title</h5>
                                <span class="badge rounded-pill @(item.Status == "Пройдено" ? "bg-success" : "bg-info text-dark")">
                                    @item.Status
                                </span>
                            </div>
                            <p class="text-muted mb-3">
                                <i class="fas fa-tag me-1 small"></i> @item.Genre
                            </p>
                        </div>
                        <div class="card-footer bg-transparent border-0 pb-3">
                            <div class="btn-group w-100 shadow-sm rounded-3 overflow-hidden">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }

        </div>
    }
</div>